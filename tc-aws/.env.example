AWS_REGION=us-east-1
AWS_PROFILE=
SM_ROLE_ARN=arn:aws:iam::<account-id>:role/<SageMakerExecutionRole>   # blank inside SageMaker Studio
BUCKET=                      # blank = SageMaker default bucket
PREFIX=text-classification
BEDROCK_MODEL=us.anthropic.claude-haiku-4-5-20251001-v1:0
BEDROCK_PRICE_IN=1.0         # USD per 1M input tokens for BEDROCK_MODEL (check current pricing)
BEDROCK_PRICE_OUT=5.0
TARGET_ACCURACY=0.97         # example 10: accuracy required on auto-handled predictions
