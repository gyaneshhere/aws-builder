# ---- Local development settings (copy to .env) ----------------------------
AWS_REGION=us-east-1
AWS_PROFILE=dba-nonprod-aws-poweruser

# Jev (local runs read the key directly; Runtime uses AgentCore Identity)
JEV_API_KEY=jv_live_your_key_here
JEV_API_URL=https://jevtypesafeai.com/api/v1/decide
JEV_MODEL=jev-latest            # pin a version before production use

# Policy thresholds (code-enforced)
TIER_CONFIDENCE_MIN=0.60
TRANSIENT_WATCH_MIN=0.70
PAGE_NOW_MIN=0.50

# Bedrock inference profiles per tier
MODEL_L1=us.amazon.nova-2-lite-v1:0
MODEL_L2=us.amazon.nova-pro-v1:0
MODEL_L3=us.anthropic.claude-sonnet-4-6

# ---- Filled in by deploy scripts (see .triage_state.json) ----------------
# MEMORY_ID=
# GATEWAY_URL=
# GATEWAY_SCOPE=
# Local-dev token path for the Gateway (Runtime uses AgentCore Identity instead):
# GATEWAY_TOKEN_URL=
# GATEWAY_CLIENT_ID=
# GATEWAY_CLIENT_SECRET=

# ---- Deploy inputs ----------------------------------------------------------
# Comma-separated OpenSearch domain names the diagnostics Lambda may query
TRIAGE_DOMAINS=metrictestopenai
# S3 bucket for the Runtime code package
DEPLOY_BUCKET=your-artifact-bucket
# Pre-created IAM roles (PowerUser profiles usually cannot create IAM roles).
# Leave empty to let the scripts try to create them.
LAMBDA_ROLE_ARN=
GATEWAY_ROLE_ARN=
RUNTIME_ROLE_ARN=
